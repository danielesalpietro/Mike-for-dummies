# ════════════════════════════════════════════════════════════════════════════
#  Mike — environment file for local Docker Compose
#  Copy this file to .env and fill in the empty values.
#
#    cp .env.docker.example .env
#
#  Variables marked [pre-filled] work out of the box for local development.
#  Variables marked [required] must be filled before starting the stack.
#  Variables marked [optional] have sensible defaults if left empty.
# ════════════════════════════════════════════════════════════════════════════


# ── PostgreSQL ───────────────────────────────────────────────────────────────
# [pre-filled] Password for the local PostgreSQL superuser.
POSTGRES_PASSWORD=postgres


# ── Exposed ports ────────────────────────────────────────────────────────────
# [pre-filled] Change only if these ports are already in use on your machine.
SUPABASE_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ── Supabase JWT ─────────────────────────────────────────────────────────────
# [pre-filled] DO NOT change JWT_SECRET without regenerating ANON_KEY and
# SERVICE_ROLE_KEY. These values are safe for local use only — never use
# them in production.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU


# ── MinIO (S3-compatible storage) ────────────────────────────────────────────
# [pre-filled] MinIO console: http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
R2_BUCKET_NAME=mike


# ── Site URL ─────────────────────────────────────────────────────────────────
# [pre-filled] Used by GoTrue for email verification links.
SITE_URL=http://localhost:3000

# [pre-filled] External URL of the auth API (GoTrue requirement).
API_EXTERNAL_URL=http://localhost:8000


# ── Backend — LLM API keys ───────────────────────────────────────────────────
# [required] At least one of the two must be provided.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ── Backend — internal settings ──────────────────────────────────────────────
# [required] Random string used to sign download tokens. Use any long random
# value, e.g.: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# [pre-filled]
FRONTEND_URL=http://localhost:3000
PORT=3001


# ── Frontend ─────────────────────────────────────────────────────────────────
# [pre-filled] These are derived from the Supabase vars above.
# Override only if you changed SUPABASE_PORT or ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
