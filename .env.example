# =============================================================================
# Mike Enterprise AI Platform — Root Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Core ports (change only if you have conflicts)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=3001

# -----------------------------------------------------------------------------
# PostgreSQL — shared database for all services
# -----------------------------------------------------------------------------
POSTGRES_USER=mike
POSTGRES_PASSWORD=mike_secret
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO — local S3-compatible storage
# Use this instead of Cloudflare R2 for a fully self-hosted setup.
# Console UI → http://localhost:9001
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# AI Stack (--profile ai)
# -----------------------------------------------------------------------------

# Qdrant vector database
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                         # leave empty for no auth (dev)
QDRANT_COLLECTION=mike_docs

# Embedding model (HuggingFace model id)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG service
RAG_PORT=8001
RAG_TOP_K=5

# Mem0 memory service
MEM0_PORT=8002

# MLflow experiment tracking
MLFLOW_PORT=5000

# Ollama local LLM server
OLLAMA_PORT=11434
# After startup pull a model: docker exec mike_ollama ollama pull llama3.2

# Open WebUI — chat interface for Ollama
OPEN_WEBUI_PORT=3002
WEBUI_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
OPEN_WEBUI_ENABLE_SIGNUP=true

# LLM API keys (used by rag-service and the Mike backend)
ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key          # optional — for OpenAI embeddings

# -----------------------------------------------------------------------------
# Data Engineering (--profile data)
# -----------------------------------------------------------------------------

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_UID=50000

# Spark
SPARK_WEB_PORT=8090
SPARK_MASTER_PORT=7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# Apache Livy (REST API for Spark)
LIVY_PORT=8998

# -----------------------------------------------------------------------------
# BI (--profile bi)
# -----------------------------------------------------------------------------
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-in-production-use-openssl-rand-base64-42

# -----------------------------------------------------------------------------
# Security (--profile security)
# -----------------------------------------------------------------------------
KEYCLOAK_PORT=8443
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=localhost
