# ─── Variabili per docker-compose (sviluppo locale) ──────────────────────────
# Copia questo file in .env e modifica i valori se necessario.
# Le chiavi JWT qui sotto sono pre-generate per uso locale con il JWT_SECRET
# indicato — non usarle in produzione.

# PostgreSQL
POSTGRES_PASSWORD=postgres

# Porte esposte (modificabili in caso di conflitti)
SUPABASE_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Supabase JWT — NON cambiare senza rigenerare ANON_KEY e SERVICE_ROLE_KEY
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# JWT pre-generati per uso locale (scadono il 2033)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
R2_BUCKET_NAME=mike

# URL del sito (usato da GoTrue per i link nelle email)
SITE_URL=http://localhost:3000

# ─── LLM keys (backend + Mem0) ───────────────────────────────────────────────
# Almeno una delle due chiavi è richiesta dal backend Mike.
# Mem0 usa ANTHROPIC_API_KEY per il reasoning (claude-haiku) e
# GEMINI_API_KEY per gli embeddings (gemini-embedding-001).
# Se hai solo una delle due, Mem0 userà quella disponibile per gli embeddings.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DOWNLOAD_SIGNING_SECRET=

# ─── Mem0 — override opzionale dei modelli ────────────────────────────────────
# MEM0_LLM_MODEL=claude-haiku-4-5-20251001
# MEM0_EMBEDDER_MODEL=models/gemini-embedding-001
